BOT_TOKEN=replace_with_bot_token
BOOTSTRAP_CODE=replace_with_random_code
ACCOUNT_JSON=account/primary.json
ACCOUNT_SESSION=account/primary
# Optional second account: fill both values after completing login.
ACCOUNT_JSON_2=
ACCOUNT_SESSION_2=
# ACCOUNT_JSON_2=account/secondary.json
# ACCOUNT_SESSION_2=account/secondary
# Future accounts: append paired _3, _4, ... slots after login is complete.
# ACCOUNT_JSON_3=account/third.json
# ACCOUNT_SESSION_3=account/third
# ACCOUNT_JSON_4=account/fourth.json
# ACCOUNT_SESSION_4=account/fourth
BOT_SESSION=data/bot
DATABASE=data/bot.sqlite3
# Optional SOCKS5 proxy, e.g. socks5://host:port
TELEGRAM_PROXY=
# Optional comma-separated source group IDs. Empty means all groups joined by the user account.
CHEAT_GROUP_IDS=
# Optional per-account concurrency and automatic bulk scaling.
ACCOUNT_RPC_CONCURRENCY=4
ACCOUNT_MEMBER_CONCURRENCY=2
BULK_WORKERS_PER_ACCOUNT=4
BULK_WORKER_LIMIT=32
SOURCE_WORKER_LIMIT=32
QUERY_PARTIAL_CACHE_SECONDS=20
QUERY_CACHE_ENTRIES=4096

# Optional pre-join policy: set the admin username that requires manual joining.
# The example is a placeholder; use your own policy account or leave this empty.
WATCHED_ADMIN_USERNAME=example_policy_bot

# Local SSH deployment settings. Obtain the host key fingerprint independently.
DEPLOY_HOST=example.com
DEPLOY_USER=deploy
DEPLOY_HOST_FINGERPRINT=SHA256:replace_with_verified_host_fingerprint
DEPLOY_REMOTE=/opt/cheatcheck

# Optional diagnostic targets (set only when running diagnostic tools).
BULK_PROBE_CHAT_ID=
BULK_PROBE_USERNAME=
DIAGNOSTIC_GROUP=
DIAGNOSTIC_NAME_FRAGMENT=
DIAGNOSTIC_TARGET_NAME=
